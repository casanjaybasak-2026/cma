# Frontend (safe to expose — publishable/anon key only, never the service role key)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# App
VITE_APP_NAME="Bank Loan Document Scanner"
VITE_SESSION_TIMEOUT_MINUTES=20
VITE_MAX_UPLOAD_MB=25

# ---------------------------------------------------------------------------
# Supabase Edge Function secrets (set with `supabase secrets set --env-file .env.functions`)
# NEVER put these in a VITE_ prefixed variable or in any frontend bundle.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# RESEND_API_KEY=YOUR_RESEND_API_KEY
# EMAIL_FROM_ADDRESS=loans@yourbank.example
# APPROVAL_PACK_LINK_EXPIRY_SECONDS=259200
